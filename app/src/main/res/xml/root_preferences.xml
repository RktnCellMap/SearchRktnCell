<PreferenceScreen
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <DropDownPreference
            app:key="keepScreenOn"
            app:title="画面ON"
            app:entries="@array/keepScreenOnEntries"
            app:entryValues="@array/keepScreenOnEntryValues"
            android:defaultValue="ON"
            app:useSimpleSummaryProvider="true"
    />

    <DropDownPreference
            app:key="theme"
            app:title="テーマ"
            app:entries="@array/themeEntries"
            app:entryValues="@array/themeEntryValues"
            android:defaultValue="MODE_NIGHT_FOLLOW_SYSTEM"
            app:useSimpleSummaryProvider="true"
    />

    <SwitchPreference
            app:key="locationMode"
            app:title="現在地追従モード"
            android:summaryOn="基地局が見えるよう拡縮する"
            android:summaryOff="現在地のみ"
            android:defaultValue="true"
    />

    <EditTextPreference
            app:key="minDistance"
            app:title="拡大するときに最小限見える半径[m]"
            android:defaultValue="300"
            app:useSimpleSummaryProvider="true"
            />
    <EditTextPreference
            app:key="maxDistance"
            app:title="広域にするときの最大距離[m]"
            android:defaultValue="2000"
            app:useSimpleSummaryProvider="true"
            />

    <SwitchPreference
            app:key="locationTimer"
            app:title="現在地連動タイマー"
            android:summaryOn="一定時間後、現在地連動に戻す"
            android:summaryOff="現在地連動に戻さない"
            android:defaultValue="true"
    />
    <SeekBarPreference
            app:key="locationTimerSecs"
            app:title="現在地連動に戻す秒数"
            android:dependency="locationTimer"
            android:max="60"
            app:min="5"
            android:defaultValue="60"
            app:showSeekBarValue="true"
    />

    <SeekBarPreference
            app:key="refreshInterval"
            app:title="現在地更新間隔[秒]"
            android:max="10"
            app:min="1"
            android:defaultValue="1"
            app:showSeekBarValue="true"
    />

    <SwitchPreference
            app:key="headingUp"
            app:title="ノースアップ/ヘディングアップ"
            android:summaryOn="ヘディングアップ"
            android:summaryOff="ノースアップ"
            android:defaultValue="false"
    />
    <DropDownPreference
            app:key="headingUpMode"
            app:title="ヘディングアップの方式"
            app:entries="@array/headingUpModeEntries"
            app:entryValues="@array/headingUpModeValues"
            android:defaultValue="GPS"
            app:useSimpleSummaryProvider="true"
            />
    <SeekBarPreference
            app:key="headingUpSpeed"
            app:title="ヘディングアップ有効速度[km/h]"
            android:summary="小さいほど過敏"
            android:max="20"
            app:min="1"
            android:defaultValue="10"
            app:showSeekBarValue="true"
    />
    <SeekBarPreference
            app:key="headingUpBearingAccuracyDegrees"
            app:title="ヘディングアップ有効方位精度[度]"
            android:summary="大きいほど過敏"
            android:max="20"
            app:min="0"
            android:defaultValue="5"
            app:showSeekBarValue="true"
    />

    <DropDownPreference
            app:key="mapType"
            app:title="地図の種類"
            app:entries="@array/mapTypeEntries"
            app:entryValues="@array/mapTypeEntryValues"
            android:defaultValue="MAP_TYPE_NORMAL"
            app:useSimpleSummaryProvider="true"
            />
    <SwitchPreference
            app:key="mapLayerTraffic"
            app:title="交通状況"
            android:summaryOn="表示"
            android:summaryOff="非表示"
            android:defaultValue="false"
            />

    <EditTextPreference
            app:key="myMapUrl"
            app:title="Googleマイマップ URL"
            app:useSimpleSummaryProvider="true"
    />
    <SwitchPreference
            app:key="myMapUrlEnable"
            app:title="Googleマイマップ 有効/無効"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
    />

    <EditTextPreference
            app:key="myMapUrl2"
            app:title="Googleマイマップ2 URL"
            app:useSimpleSummaryProvider="true"
    />
    <SwitchPreference
            app:key="myMapUrl2Enable"
            app:title="Googleマイマップ2 有効/無効"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
    />

    <EditTextPreference
            app:key="myMapUrl3"
            app:title="Googleマイマップ3 URL"
            app:useSimpleSummaryProvider="true"
    />
    <SwitchPreference
            app:key="myMapUrl3Enable"
            app:title="Googleマイマップ3 有効/無効"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
    />

    <EditTextPreference
            app:key="myMapUrl4"
            app:title="Googleマイマップ4 URL"
            app:useSimpleSummaryProvider="true"
    />
    <SwitchPreference
            app:key="myMapUrl4Enable"
            app:title="Googleマイマップ4 有効/無効"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
    />

    <EditTextPreference
            app:key="myMapUrl5"
            app:title="Googleマイマップ5 URL"
            app:useSimpleSummaryProvider="true"
    />
    <SwitchPreference
            app:key="myMapUrl5Enable"
            app:title="Googleマイマップ5 有効/無効"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
    />

    <SwitchPreference
            app:key="displayCellName"
            app:title="マイマップで認識した基地局の名前"
            android:summaryOn="表示する"
            android:summaryOff="表示しない"
            android:defaultValue="true"
    />
    <SwitchPreference
            app:key="plotMyMapCell"
            app:title="マイマップで認識した基地局の軌跡"
            android:summaryOn="プロットする"
            android:summaryOff="プロットしない"
            android:defaultValue="false"
    />

    <SwitchPreference
            app:key="plotPartner"
            app:title="パートナーエリアの軌跡"
            android:summaryOn="プロットする"
            android:summaryOff="プロットしない"
            android:defaultValue="false"
    />

    <EditTextPreference
            app:key="excludeTac"
            app:title="軌跡をプロットしないTAC（カンマ区切りで複数指定可）"
            app:useSimpleSummaryProvider="true"
    />

    <SeekBarPreference
            app:key="radioInfoTaThreshold"
            app:title="最良電測ポイントの閾値・TA"
            android:max="5"
            app:min="0"
            android:defaultValue="1"
            app:showSeekBarValue="true"
    />

    <SeekBarPreference
            app:key="radioInfoRsrpThreshold"
            app:title="最良電測ポイントの閾値・RSRP"
            android:max="-60"
            app:min="-80"
            android:defaultValue="-70"
            app:showSeekBarValue="true"
    />
    <Preference
            android:key="deleteAllRadioInfoButton"
            android:title="最良電測ポイントの削除"
            android:summary="記録した最良電測ポイントを全て消去します"
    />

    <SwitchPreference
            app:key="bwFromEarfcn"
            app:title="バンド幅取得元"
            android:summaryOn="EARFCNから推定"
            android:summaryOff="APIから"
            android:defaultValue="false"
            app:isPreferenceVisible="false"
    />

    <DropDownPreference
            app:key="dbmBarDesign"
            app:title="バーグラフのデザイン"
            app:entries="@array/dbmBarDesignEntries"
            app:entryValues="@array/dbmBarDesignValues"
            android:defaultValue="default"
            app:useSimpleSummaryProvider="true"
    />

    <EditTextPreference
            app:key="dummyCommunicationUrl"
            app:title="ダミー通信用のURL"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="https://cellmap.rukihena.com/dummy.html"
            />
    <SeekBarPreference
            app:key="dummyCommunicationInterval"
            app:title="ダミー通信の間隔[秒]"
            android:max="30"
            app:min="1"
            android:defaultValue="5"
            app:showSeekBarValue="true"
            />
    <SwitchPreference
            app:key="dummyCommunicationEnable"
            app:title="ダミー通信を行う"
            android:summary="TA表示のためには通信していることが必要です"
            android:summaryOn="有効"
            android:summaryOff="無効"
            android:defaultValue="true"
            />
    <SwitchPreference
            app:key="countermeasuresForTaNotBeingUpdated"
            app:title="Samsung機でTAが更新されない件の対策"
            android:summary="一定以上移動しても更新されない場合は - 表示にします"
            android:summaryOn="対策する"
            android:summaryOff="対策しない(通常)"
            android:defaultValue="false"
            />

    <SeekBarPreference
            app:key="eciChangeDistThreshold"
            app:title="eNB-LCID変更認識距離[km]"
            android:max="20"
            app:min="1"
            android:defaultValue="3"
            app:showSeekBarValue="true"
            />

    <Preference
            app:key="version"
            app:title="バージョン"
            app:summary="x.x.x"
            />
    <Preference
            app:key="exportPreferenceButton"
            app:title="設定エクスポート"
            app:summary="設定をファイルに書き出します"
            />
    <Preference
            app:key="importPreferenceButton"
            app:title="設定インポート"
            app:summary="設定をファイルから読み込みます"
            />

   <!-- 以下、データ保存用 -->
   <Preference
            app:key="destination"
            app:title="目的地(lat,lan)"
            app:summary="データ保存用です"
            app:isPreferenceVisible="false"
    />
    <SwitchPreference
            app:key="cellInfoViewLarge"
            app:title="電測表示部大小"
            app:summary="データ保存用です"
            android:defaultValue="false"
            app:isPreferenceVisible="false"
            />
    <SwitchPreference
            app:key="lcidViewVisible"
            app:title="LCID表示非表示"
            app:summary="データ保存用です"
            android:defaultValue="false"
            app:isPreferenceVisible="false"
            />
</PreferenceScreen>