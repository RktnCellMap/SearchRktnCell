<PreferenceScreen
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <DropDownPreference
            app:key="keepScreenOn"
            app:title="画面ON"
            app:entries="@array/keepScreenOnEntries"
            app:entryValues="@array/keepScreenOnEntryValues"
            android:defaultValue="POWER"
            app:useSimpleSummaryProvider="true"
    />

    <SwitchPreference
            app:key="locationMode"
            app:title="現在地追従モード"
            android:summaryOn="基地局が見えるよう拡縮する"
            android:summaryOff="現在地のみ"
            android:defaultValue="true"
    />

    <SwitchPreference
            app:key="locationTimer"
            app:title="現在地連動タイマー"
            android:summaryOn="一定時間後、現在地連動に戻す"
            android:summaryOff="現在地連動に戻さない"
            android:defaultValue="true"
    />
    <SeekBarPreference
            app:key="locationTimerSecs"
            app:title="現在地連動に戻す秒数"
            android:dependency="locationTimer"
            android:max="60"
            app:min="5"
            android:defaultValue="60"
            app:showSeekBarValue="true"
    />

    <SeekBarPreference
            app:key="refreshInterval"
            app:title="現在地更新間隔"
            android:max="10"
            app:min="1"
            android:defaultValue="5"
            app:showSeekBarValue="true"
    />

    <EditTextPreference
            app:key="myMapUrl"
            app:title="GoogleマイマップURL"
            app:useSimpleSummaryProvider="true"
    />

    <EditTextPreference
            app:key="myMapUrl2"
            app:title="GoogleマイマップURL2"
            app:useSimpleSummaryProvider="true"
    />
    <EditTextPreference
            app:key="myMapUrl3"
            app:title="GoogleマイマップURL3"
            app:useSimpleSummaryProvider="true"
    />
    <EditTextPreference
            app:key="myMapUrl4"
            app:title="GoogleマイマップURL4"
            app:useSimpleSummaryProvider="true"
    />
    <EditTextPreference
            app:key="myMapUrl5"
            app:title="GoogleマイマップURL5"
            app:useSimpleSummaryProvider="true"
    />

    <SwitchPreference
            app:key="displayCellName"
            app:title="マイマップで認識した基地局の名前"
            android:summaryOn="表示する"
            android:summaryOff="表示しない"
            android:defaultValue="true"
    />
    <SwitchPreference
            app:key="plotMyMapCell"
            app:title="マイマップで認識した基地局の軌跡"
            android:summaryOn="プロットする"
            android:summaryOff="プロットしない"
            android:defaultValue="true"
    />

    <SwitchPreference
            app:key="plotPartner"
            app:title="パートナーエリアの軌跡"
            android:summaryOn="プロットする"
            android:summaryOff="プロットしない"
            android:defaultValue="false"
    />

    <SeekBarPreference
            app:key="radioInfoTaThreshold"
            app:title="最良電測ポイントの閾値・TA"
            android:max="5"
            app:min="0"
            android:defaultValue="1"
            app:showSeekBarValue="true"
    />

    <SeekBarPreference
            app:key="radioInfoRsrpThreshold"
            app:title="最良電測ポイントの閾値・RSRP"
            android:max="-60"
            app:min="-80"
            android:defaultValue="-70"
            app:showSeekBarValue="true"
    />

    <SwitchPreference
            app:key="bwFromEarfcn"
            app:title="バンド幅取得元"
            android:summaryOn="EARFCNから推定"
            android:summaryOff="APIから"
            android:defaultValue="false"
            app:isPreferenceVisible="false"
    />

    <DropDownPreference
            app:key="dbmBarDesign"
            app:title="バーグラフのデザイン"
            app:entries="@array/dbmBarDesignEntries"
            app:entryValues="@array/dbmBarDesignValues"
            android:defaultValue="default"
            app:useSimpleSummaryProvider="true"
    />

    <Preference
            app:key="version"
            app:title="バージョン"
            app:summary="x.x.x"
    />

</PreferenceScreen>