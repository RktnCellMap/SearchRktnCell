<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">
    <jp.tech4u.searchrktncell.CellInfoView
            android:background="@color/colorForeign"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:id="@+id/cellInfoView"
            app:stringL1="eNB-LCID: -"
            app:stringL2="PCI: -  BW: -"
            app:stringR="TA: -"
    />
    <jp.tech4u.searchrktncell.LcidView
            android:background="@color/colorForeign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/lcidView"
        />
    <RelativeLayout
            android:id="@+id/layoutMain"
            android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark">

        <fragment
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/map"
                tools:context=".MapsActivity"
                android:name="com.google.android.gms.maps.SupportMapFragment" />
<!--右上-->
        <ImageButton
                android:id="@+id/btnGps"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="48dp"
                android:layout_alignParentRight="true"
                android:background="@color/colorMapObjBg"
                android:elevation="5dp"
                app:srcCompat="@drawable/gps_not_fixed" />
        <ImageButton
                android:id="@+id/btnCellFit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="96dp"
                android:layout_alignParentRight="true"
                android:background="@color/colorMapObjBg"
                android:elevation="5dp"
                app:srcCompat="@drawable/focus_off"
                android:onClick="onClickBtnCellFit"
                />
        <ImageButton
                android:id="@+id/btnLayers"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="144dp"
                android:layout_alignParentRight="true"
                android:background="@color/colorMapObjBg"
                android:elevation="5dp"
                app:srcCompat="@drawable/layers"
                android:onClick="onClickBtnLayers"
                />
<!--左上-->
        <ImageButton
                android:id="@+id/btnCompass"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="48dp"
                android:scaleX="1.6"
                android:scaleY="1.6"
                android:background="@android:color/transparent"
                android:elevation="5dp"
                app:srcCompat="@drawable/northup"
                android:onClick="onClickBtnCompass" />

        <ImageButton
                android:id="@+id/btnHeadingUpMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="96dp"
                android:scaleX="1.33"
                android:scaleY="1.33"
                android:background="@android:color/transparent"
                android:elevation="5dp"
                app:srcCompat="@drawable/car"
                android:visibility="invisible"
                android:onClick="onClickBtnHeadingUpMode" />
<!--中央-->
        <ImageView
                android:id="@+id/imgLocationCenter"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_location_center"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:visibility="invisible"
        />

<!--上-->
        <!-- NameとEciは重なってます(よりよいレイアウトを検討したい) -->
        <TextView
                android:id="@+id/txtCellInfoEci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="2dp"
                android:paddingHorizontal="4dp"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
                />
        <TextView
                android:id="@+id/txtCellInfoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="2dp"
                android:paddingHorizontal="4dp"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
                />
<!--上(基地局情報)-->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="42dp"
                android:gravity="center">

            <TextView
                    android:id="@+id/txtCellInfoTac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:textSize="16dp"
                    android:background="@color/colorMapObjBg"
                    android:textColor="@color/colorMapObjFg"
                    android:visibility="invisible" />

            <View
                    android:layout_width="4dp"
                    android:layout_height="4dp" />

            <TextView
                    android:id="@+id/txtCellInfoPci"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:textSize="16dp"
                    android:background="@color/colorMapObjBg"
                    android:textColor="@color/colorMapObjFg"
                    android:visibility="invisible" />
        </LinearLayout>
<!--下-->
        <TextView
                android:id="@+id/txtDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
        />
        <TextView
                android:id="@+id/txtDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
        />
        <TextView
                android:id="@+id/txtLatLng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:onClick="onClickTxtLatLng"
        />
        <com.github.pengrad.mapscaleview.MapScaleView
                android:id="@+id/scaleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                app:scale_miles="false"
        />

<!--中央 ローディングインジケーター -->
        <LinearLayout
                android:id="@+id/layoutReloadIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_centerVertical="true"
                >
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            <ProgressBar
                    android:id="@+id/pBarMyMap1"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            <ProgressBar
                    android:id="@+id/pBarMyMap2"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            <ProgressBar
                    android:id="@+id/pBarMyMap3"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            <ProgressBar
                    android:id="@+id/pBarMyMap4"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            <ProgressBar
                    android:id="@+id/pBarMyMap5"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
        </LinearLayout>

<!--下 レイヤメニュー -->
        <LinearLayout
                android:id="@+id/layoutLayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="0dp"
                android:layout_alignParentBottom="true"
                android:gravity="center"
                android:background="@color/colorLayersMenuBg"
                android:onClick="onClickDummy"
                >

            <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginHorizontal="10dp"
                        android:padding="5dp">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="地図・レイヤ"
                            android:textSize="16dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/colorMapObjFg" />
                </LinearLayout>

                <ImageButton
                        android:id="@+id/btnCloseLayers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="12dp"
                        android:layout_alignParentRight="true"
                        app:srcCompat="@drawable/close"
                        android:background="@android:color/transparent"
                        android:onClick="onClickBtnLayers" />
            </RelativeLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:padding="5dp">

                <TextView
                        android:id="@+id/txtMapStandard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="地図\n　標準　"
                        android:textSize="14dp"
                        android:padding="4dp"
                        android:elevation="5dp"
                        android:background="@color/colorMapObjBg"
                        android:textColor="@color/colorMapObjFg"
                        android:onClick="onClickMapStandard" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <TextView
                        android:id="@+id/txtMapSatellite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="地図\n航空写真"
                        android:textSize="14dp"
                        android:padding="4dp"
                        android:elevation="5dp"
                        android:background="@color/colorMapObjBg"
                        android:textColor="@color/colorMapObjFg"
                        android:onClick="onClickMapSatellite" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <TextView
                        android:id="@+id/txtMapTerrain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="地図\n　地形　"
                        android:textSize="14dp"
                        android:padding="4dp"
                        android:elevation="5dp"
                        android:background="@color/colorMapObjBg"
                        android:textColor="@color/colorMapObjFg"
                        android:onClick="onClickMapTerrain" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5" />

                <TextView
                        android:id="@+id/txtMapTraffic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="レイヤ\n交通状況"
                        android:textSize="14dp"
                        android:padding="4dp"
                        android:elevation="5dp"
                        android:background="@color/colorMapObjBg"
                        android:textColor="@color/colorMapObjFg"
                        android:onClick="onClickMapTraffic" />
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="マイマップ"
                    android:textSize="16dp"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/colorMapObjFg" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:padding="5dp">

                <ImageButton
                        android:id="@+id/btnMyMap1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/colorMapObjBg"
                        android:elevation="5dp"
                        app:srcCompat="@drawable/rect1"
                        android:onClick="onClickMyMap1" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <ImageButton
                        android:id="@+id/btnMyMap2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/colorMapObjBg"
                        android:elevation="5dp"
                        app:srcCompat="@drawable/rect2"
                        android:onClick="onClickMyMap2" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <ImageButton
                        android:id="@+id/btnMyMap3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/colorMapObjBg"
                        android:elevation="5dp"
                        app:srcCompat="@drawable/rect3"
                        android:onClick="onClickMyMap3" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <ImageButton
                        android:id="@+id/btnMyMap4"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/colorMapObjBg"
                        android:elevation="5dp"
                        app:srcCompat="@drawable/rect4"
                        android:onClick="onClickMyMap4" />

                <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                <ImageButton
                        android:id="@+id/btnMyMap5"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/colorMapObjBg"
                        android:elevation="5dp"
                        app:srcCompat="@drawable/rect5"
                        android:onClick="onClickMyMap5" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
