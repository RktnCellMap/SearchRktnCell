<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">
    <jp.tech4u.searchrktncell.CellInfoView
            android:background="@color/colorForeign"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:id="@+id/cellInfoView"
            app:stringL1="eNB-LCID: -"
            app:stringL2="PCI: -  BW: -"
            app:stringR="TA: -"
    />
    <RelativeLayout
            android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark">
        <fragment
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/map"
                tools:context=".MapsActivity"
                android:name="com.google.android.gms.maps.SupportMapFragment"/>
        <TextView
                android:id="@+id/txtCellName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="20dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="#A0FFFFFF"
                android:textColor="#222222" />
        <ImageButton
                android:id="@+id/btnGps"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_alignParentRight="true"
                android:background="#D0ffffff"
                android:elevation="5dp"
                app:srcCompat="@drawable/gps_not_fixed"

        />
        <TextView
                android:id="@+id/txtLatLng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="#A0FFFFFF"
                android:textColor="#222222" />
    </RelativeLayout>
</LinearLayout>
