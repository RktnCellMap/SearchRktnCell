<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">
    <jp.tech4u.searchrktncell.CellInfoView
            android:background="@color/colorForeign"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:id="@+id/cellInfoView"
            app:stringL1="eNB-LCID: -"
            app:stringL2="PCI: -  BW: -"
            app:stringR="TA: -"
    />
    <RelativeLayout
            android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:theme="@style/ThemeOverlay.AppCompat.Dark">
        <fragment
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/map"
                tools:context=".MapsActivity"
                android:name="com.google.android.gms.maps.SupportMapFragment"/>
        <ImageButton
                android:id="@+id/btnGps"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_alignParentRight="true"
                android:background="@color/colorMapObjBg"
                android:elevation="5dp"
                app:srcCompat="@drawable/gps_not_fixed"
        />
        <ImageView
                android:id="@+id/imgLocationCenter"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/ic_location_center"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:visibility="invisible"
        />
        <TextView
                android:id="@+id/txtCellInfoEci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="2dp"
                android:paddingHorizontal="4dp"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
        />
        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:layout_marginTop="42dp"
                      android:gravity="center"
        >
            <TextView
                    android:id="@+id/txtCellInfoTac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:textSize="16dp"
                    android:background="@color/colorMapObjBg"
                    android:textColor="@color/colorMapObjFg"
                    android:visibility="invisible"
            />
            <View android:layout_width="4dp" android:layout_height="4dp"/>
            <TextView
                    android:id="@+id/txtCellInfoPci"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:textSize="16dp"
                    android:background="@color/colorMapObjBg"
                    android:textColor="@color/colorMapObjFg"
                    android:visibility="invisible"
            />
        </LinearLayout>
        <TextView
                android:id="@+id/txtDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
        />
        <TextView
                android:id="@+id/txtDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:visibility="invisible"
        />
        <TextView
                android:id="@+id/txtLatLng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_alignParentBottom="true"
                android:paddingVertical="2dp"
                android:paddingHorizontal="8dp"
                android:textSize="16dp"
                android:gravity="center_horizontal"
                android:layout_centerHorizontal="true"
                android:background="@color/colorMapObjBg"
                android:textColor="@color/colorMapObjFg"
                android:onClick="onClickTxtLatLng"
        />
        <com.github.pengrad.mapscaleview.MapScaleView
                android:id="@+id/scaleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                app:scale_miles="false"
        />
    </RelativeLayout>
</LinearLayout>
